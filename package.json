{
  "name": "retro-entertainment-recommender",
  "version": "2.0.0",
  "description": "R.E.T.R.O. - TypeScript, Node.js, HTML & CSS Edition",
  "scripts": {
    "build:client": "esbuild src/client/app.ts --bundle --outfile=public/dist/app.js --target=es2020",
    "dev": "npm run build:client && tsx watch src/server.ts",
    "start": "npm run build:client && tsx src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "esbuild": "^0.20.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
